{
  "name": "oxlint-plugin-oxfmt",
  "version": "0.1.0",
  "description": "An oxlint plugin that reports oxfmt formatting differences as lint diagnostics, with autofix.",
  "keywords": [
    "formatter",
    "lint",
    "oxc",
    "oxfmt",
    "oxlint",
    "oxlint-plugin",
    "prettier"
  ],
  "homepage": "https://github.com/qualitybath/oxlint-plugin-oxfmt#readme",
  "bugs": "https://github.com/qualitybath/oxlint-plugin-oxfmt/issues",
  "license": "MIT",
  "author": "Mordy Tikotzky <mordyt@qualitybath.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualitybath/oxlint-plugin-oxfmt.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo",
    "test": "bun test",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.67.0",
    "prettier-linter-helpers": "^1.0.1",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0"
  },
  "peerDependencies": {
    "oxfmt": ">=0.52.0",
    "oxlint": ">=1.67.0"
  },
  "engines": {
    "node": ">=18"
  }
}
